# Copy to .env and fill in from your own deployment's outputs. Never commit a
# populated .env — see .gitignore.
#
# These values come from the OFFICIAL LAB's deployment, which you must run
# first: https://github.com/Azure-Samples/AI-Gateway/tree/main/labs/ai-foundry-hosted-agents-custom-framework
#
#   az deployment group show \
#     --resource-group <your-resource-group> \
#     --name <your-deployment-name> \
#     --query properties.outputs
#
# The broker authenticates to Azure with DefaultAzureCredential, i.e. your own
# `az login` session. There is no service principal secret to put here. Deployed
# to App Service it resolves the site's managed identity instead, with no code
# change and no credential in configuration.
#
# Deploying the whole demo to Azure needs none of this file:
# labs/ai-foundry-hosted-agents-custom-framework-automation/scripts/deploy.ps1
# writes every value below as an App Service application setting.
#
# Local run: `npm run dev` (watch) or `npm run build && npm start`.

PORT=4000
# Comma-separated list of origins the Vite dev server may run on. Irrelevant in
# the App Service deployment, where the broker serves the console itself and
# browser and API share one origin.
CORS_ORIGIN=http://localhost:5173

# Optional. Folder holding a built console (demo-app/dist). When set - or when a
# ./public folder sits next to the broker - Express serves the console as well
# as /api, from a single origin. Left unset locally, where Vite serves the app.
# PUBLIC_DIR=

AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group-name>
AZURE_REGION=<your-azure-region>

# main.bicep outputs (all required — the broker refuses to start without them)
APIM_GATEWAY_URL=https://<your-apim-name>.azure-api.net
APIM_SERVICE_NAME=<your-apim-service-name>
APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>
FOUNDRY_AGENTS_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODELS_ACCOUNT_NAME=<your-foundry-models-account-name>
LOG_ANALYTICS_WORKSPACE_ID=<your-log-analytics-workspace-guid>
CONTAINER_REGISTRY_NAME=<your-container-registry-name>

# Optional. Ceiling on one hosted-agent invocation before the broker reports a
# timeout instead of hanging on a stuck upstream call. Defaults to 60000.
AGENT_INVOKE_TIMEOUT_MS=60000
