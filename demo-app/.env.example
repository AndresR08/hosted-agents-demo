# Copy to .env.local for local development. Never commit a populated .env file.
#
# This browser app never talks to Azure directly (see vite.config.ts and
# src/services/azure). Every Azure call goes through the local broker process
# in ../broker, which holds the az login context and the APIM subscription key.
# Start the broker first — the console is not usable without it.

# Base URL of the broker process (../broker, default port 4000).
# Set it to "/" to build for same-origin hosting, where the broker serves this
# bundle itself — that is what the App Service deployment does. Do not use an
# empty value: Windows cannot hold an empty environment variable, so Vite would
# fall back to the localhost default.
VITE_BROKER_BASE_URL=http://localhost:4000

# Demo mode the app boots into: "live" or "replay".
#   live   — shown in the UI as "Azure Live". Reads the real deployment through
#            the broker. This is the mode the demo is built for.
#   replay — shown in the UI as "Simulation". A placeholder scaffold that
#            returns PLACEHOLDER values; the rehearsal-capture loader is NOT
#            built. Not a working offline demo — do not present from it.
VITE_DEFAULT_MODE=live

# Deployment context shown in the header's environment strip, until the broker
# supplies these live. Both are also broker outputs of the official lab's
# main.bicep — set them to match your own deployment.
VITE_REGION=<your-azure-region>
VITE_RESOURCE_GROUP_NAME=<your-resource-group-name>
